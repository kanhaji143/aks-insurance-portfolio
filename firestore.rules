rules_version = '2';

// ============================================================
// Amit Kumar Shukla — Insurance Portfolio
// Firestore Security Rules — source-controlled configuration
//
// Design:
//   - Public visitors: READ-ONLY on published AND verified content.
//     No public create/update/delete anywhere.
//   - Admins: only authenticated users whose UID is explicitly
//     listed in ADMIN_UIDS() below (no assumption that every
//     authenticated user is an admin).
//   - Current admin: one owner-supplied UID (added Nov 2026).
//   - The `admins` collection is internal-only: no public access.
//   - No sensitive credentials may be stored client-side.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Admin check (explicit UID allow-list) ----------------
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ADMIN_UIDS();
    }

    function ADMIN_UIDS() {
      // Owner-supplied Admin UID (Firebase Console > Authentication).
      return [
        "ZZ6gcuPsGyRrCIPk1WbeMu0n4lI2"
      ];
    }

    // ---- Public content: read only if published + verified ----
    function isPublicPublished() {
      return resource.data.isPublished == true
        && resource.data.isVerified == true;
    }

    // ---- insurancePlans: must keep companyId reference valid ----
    function planFieldsOk() {
      return request.resource.data.companyId is string
        && request.resource.data.isPublished is bool
        && request.resource.data.isVerified is bool;
    }

    // ============================================================
    // companies
    // ============================================================
    match /companies/{companyId} {
      allow read:   if isAdmin() || isPublicPublished();
      allow create: if isAdmin()
                    && request.resource.data.isPublished is bool
                    && request.resource.data.isVerified is bool;
      allow update: if isAdmin()
                    && request.resource.data.isPublished is bool
                    && request.resource.data.isVerified is bool;
      allow delete: if isAdmin();
    }

    // ============================================================
    // insurancePlans  (references companies/{companyId})
    // ============================================================
    match /insurancePlans/{planId} {
      allow read:   if isAdmin() || isPublicPublished();
      allow create, update: if isAdmin() && planFieldsOk();
      allow delete: if isAdmin();
    }

    // ============================================================
    // calculatorLinks  (official insurer quote/calculator URLs)
    // ============================================================
    match /calculatorLinks/{linkId} {
      allow read:   if isAdmin() || isPublicPublished();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // videos  (YouTube Knowledge Centre)
    // ============================================================
    match /videos/{videoId} {
      allow read:   if isAdmin() || isPublicPublished();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // siteSettings  — single "public" doc is world-readable;
    // everything else (internal settings) is admin-only.
    // ============================================================
    match /siteSettings/{settingsId} {
      allow read:   if (settingsId == "public" && resource.data.isPublished == true)
                    || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // admins  — internal; NO public read/write at all
    // ============================================================
    match /admins/{uid} {
      allow read:   if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---- Deny everything else by default ----------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
