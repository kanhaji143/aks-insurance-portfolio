{
    "firestore":  {
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json",
                      "database":  "default"
                  },
    "hosting":  {
                    "public":  "dist",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**",
                                   "**/dist/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ],
                    "headers":  [
                                    {
                                        "source":  "**",
                                        "headers":  [
                                                        {
                                                            "key":  "X-Content-Type-Options",
                                                            "value":  "nosniff"
                                                        },
                                                        {
                                                            "key":  "X-Frame-Options",
                                                            "value":  "DENY"
                                                        },
                                                        {
                                                            "key":  "Referrer-Policy",
                                                            "value":  "strict-origin-when-cross-origin"
                                                        },
                                                        {
                                                            "key":  "Permissions-Policy",
                                                            "value":  "camera=(), microphone=(), geolocation=()"
                                                        }
                                                    ]
                                    },
                                    {
                                        "source":  "/assets/**",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "public, max-age=31536000, immutable"
                                                        }
                                                    ]
                                    }
                                ]
                },
    "emulators":  {
                      "auth":  {
                                   "port":  9099
                               },
                      "firestore":  {
                                        "port":  8080
                                    },
                      "ui":  {
                                 "enabled":  true,
                                 "port":  4000
                             },
                      "singleProjectMode":  true
                  }
}
